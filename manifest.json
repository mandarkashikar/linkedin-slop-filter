{
  "manifest_version": 3,
  "name": "LinkedIn Slop Filter",
  "version": "0.1.0",
  "description": "Auto-fades AI slop on LinkedIn using Jev (TypeSafe AI classification)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.typesafe.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Slop Filter"
  }
}
