{
  "manifest_version": 3,
  "name": "Feed Slop Filter",
  "version": "1.3.0",
  "description": "Auto-fades AI slop and ads on LinkedIn, Substack, and X/Twitter using Jev or a local Ollama model",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://linkedin.com/*",
    "*://*.substack.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "https://api.typesafe.ai/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://linkedin.com/*",
        "*://*.substack.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "http://127.0.0.1:8765/*",
        "http://localhost:8765/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feed Slop Filter"
  }
}
